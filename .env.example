# Supabase Postgres connection string.
# Supabase → Project → Settings → Database → Connection string → "Transaction pooler"
# (host ...pooler.supabase.com, port 6543). Includes your DB password.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Editor login. Editing (the "עדכן רשימה" button + the write API) is locked
# unless BOTH are set. Set your own values in Vercel's env settings.
ADMIN_USER=you@example.com
ADMIN_PASSWORD=change-me
