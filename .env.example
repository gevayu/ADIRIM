# Local dev: a libSQL file in the repo. Runs with zero setup.
DATABASE_URL=file:./data/local.db

# Production (Vercel + Turso): set these instead of the file URL above.
# DATABASE_URL=libsql://<your-db>.turso.io
# DATABASE_AUTH_TOKEN=<your-turso-token>

# Editor login. Editing (the "עדכן רשימה" button + the write API) is locked
# unless BOTH are set. Set your own values in Vercel's env settings.
ADMIN_USER=you@example.com
ADMIN_PASSWORD=change-me
